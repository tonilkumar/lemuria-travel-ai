{
  "name": "@lemuria/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed/index.ts",
    "db:reset": "docker exec lemuria-postgres psql -U lemuria -d lemuria_dev -c \"DROP SCHEMA IF EXISTS public CASCADE; DROP SCHEMA IF EXISTS drizzle CASCADE; CREATE SCHEMA public;\" && pnpm run db:migrate && pnpm run db:seed"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "13.0.1",
    "@fastify/jwt": "9.0.1",
    "@fastify/multipart": "9.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@lemuria/shared": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "bullmq": "5.34.6",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "drizzle-orm": "0.38.3",
    "fastify": "5.2.0",
    "fastify-plugin": "5.0.1",
    "ioredis": "5.4.2",
    "nanoid": "5.0.9",
    "pino": "9.6.0",
    "postgres": "3.4.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
