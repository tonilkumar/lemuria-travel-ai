# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="Lemuria Travel AI"
APP_URL=http://localhost:5300
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5300
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://lemuria:lemuria@localhost:5432/lemuria_dev

# ─── Redis (background jobs / scheduler) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-access-secret
JWT_REFRESH_SECRET=replace-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_PEPPER=replace-me-pepper
# MFA is schema-ready in Phase 1, enforcement is off by default
MFA_ENABLED=false

# ─── AI provider (provider-agnostic abstraction) ──────────────────────────────
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=4096
# Hard governance switch: customer data is never sent for training
AI_ALLOW_PII=false

# ─── WhatsApp (official Meta Business Cloud API / BSP only) ───────────────────
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME="Lemuria India Holidays"
EMAIL_FROM_ADDRESS=

# ─── Object storage (documents / PDFs) ────────────────────────────────────────
# local | s3   (s3 driver also targets any S3-compatible endpoint)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Envelope encryption key for documents at rest (base64, 32 bytes)
DOCUMENT_ENCRYPTION_KEY=

# ─── Maps ─────────────────────────────────────────────────────────────────────
MAPS_PROVIDER=google
MAPS_API_KEY=

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
